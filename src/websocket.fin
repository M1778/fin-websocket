// SPDX-License-Identifier: MIT
// fin-websocket v0.1.0 — RFC 6455 WebSocket client + server for Fin.
//
// Scope: HTTP Upgrade handshake (server side via zhttp, client side over raw
// TCP), frame encode/decode, client masking, ping/pong, close frames,
// fragmentation reassembly. Blocking TCP only, IPv4 dotted quads (inherits
// the std networking.fin address model).
//
// Two deliberate vendored pieces (both documented, neither silent):
//   1. SHA-1: fin-crypto v0.1.0 ships SHA-256 only, and the WebSocket accept
//      key (RFC 6455 section 4.2.2) requires SHA-1. Implemented below in pure
//      Fin over bits::std, verified against Python hashlib + openssl. Filed
//      as a fin-crypto feature request (see README): when fin-crypto ships
//      sha1, this module switches to it and the vendored copy is deleted.
//   2. Base64 over byte arrays: std encoding.fin's base64_encode takes a
//      `string` and measures it with strlen, so it cannot encode binary
//      digests or random masking keys (embedded NULs truncate). ws_b64encode
//      takes an explicit length. Proposed as a std addition (see NOTES).
//
// Linux transport, validated with the frozen finc 0.4.0 compiler. Socket I/O
// requires the coordinated zhttp snapshot documented in README.md.
// Keep explicit byte lengths and ownership: Fin strings are NUL-terminated.

#[stdimport] %{
import { bit_and, bit_or, bit_xor, bit_not, rotate_left } from bits::std;
import { to_chars, from_chars, equals, concat, substr, find, trim, to_lower, len, starts_with, free_str } from strings::std;
import { c_socket, c_connect, c_close, c_inet_addr } from networking::std;
import { random_bytes, const_time_eq } from crypto::fin;
import { http_listen, http_accept, http_read_request, http_header_get, http_free_read_result, http_server_close, http_close, http_detach, http_sockaddr, http_socket_invalid, http_socket_close, http_socket_shutdown, http_socket_failed, http_socket_interrupted, http_socket_dial, http_socket_read, http_socket_write, http_socket_read_exact, http_socket_peek, http_socket_read_at, http_socket_peek_at, HttpSocket, HttpServer, HttpConn, HttpReadResult } from zhttp::fin;
}%

namespace fin {

// --- raw send and receive ---
//
// The socket handle, the buffer ABI and the error source all come from
// `zhttp`, which selects them for the native target (ADR 0051 addendum).
// Redeclaring `send`/`recv` here is what broke this module when the two
// libraries disagreed about the handle width: POSIX wants `ssize_t` and a
// `size_t` length, Winsock wants `int` for both, and a `SOCKET` is a pointer
// width, not an `int`. One declaration, one ABI, one owner.
//
// `zhttp`'s raw read and write are binary-safe: a WebSocket frame carries NUL
// bytes and arbitrary binary payloads, and a `string`-typed send would
// truncate them at the first NUL.

// MSG_PEEK is 2 on Linux, Darwin and Winsock.
priv fun ws_peek_flag() <int> { return 2; }

// Reads into `buf` at `offset`. `flags` is either 0 for a consuming read or
// the peek flag for a non-consuming one.
priv fun ws_read_at(fd: HttpSocket, buf: [char], offset: int, size: int, flags: int) <int> {
    // All callers bound sizes to 16 MiB, so positive returns fit int.
    if (flags == ws_peek_flag()) { return http_socket_peek_at(fd, buf, offset, size); }
    return http_socket_read_at(fd, buf, offset, size);
}

// --- private helpers ---

// Byte value of b[i] as uint (0..255). char may be signed; adjust like
// lib/std/encoding.fin does.
priv fun byte_at(b: [char], i: int) <uint> {
    let v <int> = cast<int>(b[i]);
    if (v < 0) { v = v + 256; }
    return cast<uint>(v);
}

// Addition modulo 2^32 that never relies on overflow wrapping (same technique
// as fin-crypto's add32).
priv fun add32(a: uint, b: uint) <uint> {
    let a_lo <uint> = a % cast<uint>(65536);
    let a_hi <uint> = a >> cast<uint>(16);
    let b_lo <uint> = b % cast<uint>(65536);
    let b_hi <uint> = b >> cast<uint>(16);
    let lo_sum <uint> = a_lo + b_lo;
    let carry <uint> = lo_sum >> cast<uint>(16);
    let lo <uint> = lo_sum % cast<uint>(65536);
    let hi <uint> = (a_hi + b_hi + carry) % cast<uint>(65536);
    return lo + (hi << cast<uint>(16));
}

priv fun load32_be(b: [char], off: int) <uint> {
    return byte_at(b, off) * cast<uint>(16777216)
         + byte_at(b, off + 1) * cast<uint>(65536)
         + byte_at(b, off + 2) * cast<uint>(256)
         + byte_at(b, off + 3);
}

// --- SHA-1 (FIPS 180-1), vendored — see header note ---
// Only used for the WebSocket accept key. Verified against Python hashlib
// and openssl: "" -> da39a3ee..., "abc" -> a9993e36..., 56-char FIPS message
// -> 84983e441c3bd26ebaae4aa1f95129e5e54670f1.

priv fun sha1_compress(h: [uint], block: [char]) <noret> {
    let w <[uint]> = new [uint, 80]{};
    for (let i <int> = 0; i < 16; i++) {
        w[i] = load32_be(block, i * 4);
    }
    for (let i <int> = 16; i < 80; i++) {
        let t <uint> = bit_xor(bit_xor(w[i - 3], w[i - 8]), bit_xor(w[i - 14], w[i - 16]));
        w[i] = rotate_left(t, cast<uint>(1));
    }
    let a <uint> = h[0];
    let b <uint> = h[1];
    let c <uint> = h[2];
    let d <uint> = h[3];
    let e <uint> = h[4];
    for (let i <int> = 0; i < 80; i++) {
        let f <uint> = cast<uint>(0);
        let k <uint> = cast<uint>(0);
        if (i < 20) {
            // f = (b AND c) OR ((NOT b) AND d); k = 0x5A827999
            f = bit_or(bit_and(b, c), bit_and(bit_not(b), d));
            k = cast<uint>(1518500249);
        } else if (i < 40) {
            // f = b XOR c XOR d; k = 0x6ED9EBA1
            f = bit_xor(bit_xor(b, c), d);
            k = cast<uint>(1859775393);
        } else if (i < 60) {
            // f = (b AND c) OR (b AND d) OR (c AND d); k = 0x8F1BBCDC
            f = bit_or(bit_or(bit_and(b, c), bit_and(b, d)), bit_and(c, d));
            k = cast<uint>(2400959708);
        } else {
            // f = b XOR c XOR d; k = 0xCA62C1D6
            f = bit_xor(bit_xor(b, c), d);
            k = cast<uint>(3395469782);
        }
        let temp <uint> = add32(add32(add32(add32(rotate_left(a, cast<uint>(5)), f), e), k), w[i]);
        e = d;
        d = c;
        c = rotate_left(b, cast<uint>(30));
        b = a;
        a = temp;
    }
    h[0] = add32(h[0], a);
    h[1] = add32(h[1], b);
    h[2] = add32(h[2], c);
    h[3] = add32(h[3], d);
    h[4] = add32(h[4], e);
    delete w;
}

// Raw 20-byte SHA-1 digest of the first len bytes of data. Caller owns it.
priv fun sha1_raw(data: [char], len: int) <[char]> {
    let n <int> = len + 9;
    let rem <int> = n % 64;
    let padded_len <int> = n;
    if (rem != 0) { padded_len = n + (64 - rem); }
    let msg <[char]> = new [char, padded_len]{};
    for (let i <int> = 0; i < len; i++) { msg[i] = data[i]; }
    msg[len] = cast<char>(128);
    for (let i <int> = len + 1; i < padded_len - 8; i++) { msg[i] = cast<char>(0); }
    let tmp <ulong> = cast<ulong>(len) * cast<ulong>(8);
    for (let i <int> = 7; i >= 0; i--) {
        msg[padded_len - 8 + i] = cast<char>(cast<int>(tmp % cast<ulong>(256)));
        tmp = tmp / cast<ulong>(256);
    }
    let h <[uint]> = [cast<uint>(1732584193), cast<uint>(4023233417), cast<uint>(2562383102), cast<uint>(271733878), cast<uint>(3285377520)];
    let blocks <int> = padded_len / 64;
    for (let b <int> = 0; b < blocks; b++) {
        let blk <[char]> = new [char, 64]{};
        for (let i <int> = 0; i < 64; i++) { blk[i] = msg[b * 64 + i]; }
        sha1_compress(h, blk);
        delete blk;
    }
    delete msg;
    let digest <[char]> = new [char, 20]{};
    for (let i <int> = 0; i < 5; i++) {
        let v <uint> = h[i];
        digest[i * 4] = cast<char>(cast<int>(v >> cast<uint>(24)));
        digest[i * 4 + 1] = cast<char>(cast<int>((v >> cast<uint>(16)) % cast<uint>(256)));
        digest[i * 4 + 2] = cast<char>(cast<int>((v >> cast<uint>(8)) % cast<uint>(256)));
        digest[i * 4 + 3] = cast<char>(cast<int>(v % cast<uint>(256)));
    }
    delete h;
    return digest;
}

priv fun hex_digit(v: uint) <char> {
    if (v < cast<uint>(10)) {
        return cast<char>(cast<int>('0') + cast<int>(v));
    }
    return cast<char>(cast<int>('a') + cast<int>(v) - 10);
}

priv fun hex_of_bytes(digest: [char], len: int) <string> {
    let out <[char]> = new [char, len * 2 + 1]{};
    for (let i <int> = 0; i < len; i++) {
        let b <uint> = byte_at(digest, i);
        out[i * 2] = hex_digit(b >> cast<uint>(4));
        out[i * 2 + 1] = hex_digit(b % cast<uint>(16));
    }
    out[len * 2] = cast<char>(0);
    let s <string> = from_chars(out, 0, len * 2);
    delete out;
    return s;
}

// --- base64 over byte arrays (vendored — see header note) ---

priv fun b64_char(v: uint) <char> {
    if (v < cast<uint>(26)) { return cast<char>(cast<int>('A') + cast<int>(v)); }
    if (v < cast<uint>(52)) { return cast<char>(cast<int>('a') + cast<int>(v) - 26); }
    if (v < cast<uint>(62)) { return cast<char>(cast<int>('0') + cast<int>(v) - 52); }
    if (v == cast<uint>(62)) { return '+'; }
    return '/';
}

// Standard base64 (with padding) of the first len bytes. The std
// base64_encode cannot do this: it strlen-measures a `string`, which
// truncates binary input at the first NUL.
#[export]
pub fun ws_b64encode(data: [char], len: int) <string> {
    blame len >= 0, "ws_b64encode: length must be non-negative";
    let out_len <int> = ((len + 2) / 3) * 4;
    let out <[char]> = new [char, out_len + 1]{};
    let i <int> = 0;
    let o <int> = 0;
    while (i + 2 < len) {
        let v <uint> = byte_at(data, i) * cast<uint>(65536)
                     + byte_at(data, i + 1) * cast<uint>(256)
                     + byte_at(data, i + 2);
        out[o] = b64_char((v >> cast<uint>(18)) % cast<uint>(64));
        out[o + 1] = b64_char((v >> cast<uint>(12)) % cast<uint>(64));
        out[o + 2] = b64_char((v >> cast<uint>(6)) % cast<uint>(64));
        out[o + 3] = b64_char(v % cast<uint>(64));
        i = i + 3;
        o = o + 4;
    }
    let rem <int> = len - i;
    if (rem == 1) {
        let v <uint> = byte_at(data, i) * cast<uint>(65536);
        out[o] = b64_char((v >> cast<uint>(18)) % cast<uint>(64));
        out[o + 1] = b64_char((v >> cast<uint>(12)) % cast<uint>(64));
        out[o + 2] = '=';
        out[o + 3] = '=';
    } else if (rem == 2) {
        let v <uint> = byte_at(data, i) * cast<uint>(65536)
                     + byte_at(data, i + 1) * cast<uint>(256);
        out[o] = b64_char((v >> cast<uint>(18)) % cast<uint>(64));
        out[o + 1] = b64_char((v >> cast<uint>(12)) % cast<uint>(64));
        out[o + 2] = b64_char((v >> cast<uint>(6)) % cast<uint>(64));
        out[o + 3] = '=';
    }
    out[out_len] = cast<char>(0);
    let s <string> = from_chars(out, 0, out_len);
    delete out;
    return s;
}

// Byte buffer returned by value; the caller owns `data` and frees it with
// ws_free_bytes.
#[export]
pub struct WsBytes {
    pub:
        data <[char]>,
        len <int>,
}

#[export]
pub fun ws_free_bytes(b: &WsBytes) <noret> {
    delete b.data;
}

priv fun b64_val(c: char) <int> {
    if (c >= 'A' && c <= 'Z') { return cast<int>(c) - cast<int>('A'); }
    if (c >= 'a' && c <= 'z') { return cast<int>(c) - cast<int>('a') + 26; }
    if (c >= '0' && c <= '9') { return cast<int>(c) - cast<int>('0') + 52; }
    if (c == '+') { return 62; }
    if (c == '/') { return 63; }
    return -1;
}

// Standard, canonical base64 decode. len=-1 when input is malformed.
#[export]
pub fun ws_b64decode(s: string) <WsBytes> {
    let n <int> = len(s);
    let bad <WsBytes> = WsBytes{data: new [char, 1]{}, len: -1};
    if (n % 4 != 0) { return bad; }
    let chars <[char]> = to_chars(s);
    let pad <int> = 0;
    if (n >= 1 && chars[n - 1] == '=') { pad++; }
    if (n >= 2 && chars[n - 2] == '=') { pad++; }
    let out_len <int> = (n / 4) * 3 - pad;
    let out <[char]> = new [char, out_len + 1]{};
    let o <int> = 0;
    let ok <bool> = true;
    for (let i <int> = 0; i < n; i = i + 4) {
        let v0 <int> = b64_val(chars[i]);
        let v1 <int> = b64_val(chars[i + 1]);
        let v2 <int> = b64_val(chars[i + 2]);
        let v3 <int> = b64_val(chars[i + 3]);
        if (v0 < 0 || v1 < 0) { ok = false; }
        if (chars[i + 2] == '=') {
            if (i + 4 != n || chars[i + 3] != '=' || v1 % 16 != 0) { ok = false; }
            v2 = 0;
        } else if (v2 < 0) { ok = false; }
        if (chars[i + 3] == '=') {
            if (i + 4 != n || v2 % 4 != 0) { ok = false; }
            v3 = 0;
        } else if (v3 < 0) { ok = false; }
        if (!ok) { break; }
        let v <int> = v0 * 262144 + v1 * 4096 + v2 * 64 + v3;
        if (o < out_len) { out[o] = cast<char>(v / 65536); o++; }
        if (o < out_len) { out[o] = cast<char>((v / 256) % 256); o++; }
        if (o < out_len) { out[o] = cast<char>(v % 256); o++; }
    }
    delete chars;
    out[out_len] = cast<char>(0);
    if (!ok) { delete out; return bad; }
    delete bad.data;
    return WsBytes{data: out, len: out_len};
}

// --- SHA-1 public wrappers (vendored — see header) ---

// SHA-1 of a string as lowercase hex (hashes bytes up to the first NUL).
#[export]
pub fun ws_sha1_hex(data: string) <string> {
    let bytes <[char]> = to_chars(data);
    let n <int> = bytes.length - 1;
    let digest <[char]> = sha1_raw(bytes, n);
    let hex <string> = hex_of_bytes(digest, 20);
    delete bytes;
    delete digest;
    return hex;
}

// SHA-1 of the first len bytes as lowercase hex.
#[export]
pub fun ws_sha1_bytes_hex(data: [char], len: int) <string> {
    blame len >= 0, "ws_sha1_bytes_hex: length must be non-negative";
    let digest <[char]> = sha1_raw(data, len);
    let hex <string> = hex_of_bytes(digest, 20);
    delete digest;
    return hex;
}

// --- WebSocket handshake (RFC 6455 section 4) ---

// Sec-WebSocket-Accept for a client key (RFC 6455 section 4.2.2):
// base64(sha1(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")).
// Test vector (RFC 6455 section 1.3): key "dGhlIHNhbXBsZSBub25jZQ==" ->
// "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=".
#[export]
pub fun ws_accept_key(client_key: string) <string> {
    let magic <string> = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    let joined <string> = concat(client_key, magic);
    let bytes <[char]> = to_chars(joined);
    free_str(joined);
    let n <int> = bytes.length - 1;
    let digest <[char]> = sha1_raw(bytes, n);
    let accept <string> = ws_b64encode(digest, 20);
    delete bytes;
    delete digest;
    return accept;
}

// A fresh client handshake key: base64 of 16 cryptographically random bytes
// (fin-crypto's /dev/urandom source). 16 bytes -> 24 chars ending in "==".
#[export]
pub fun ws_client_key() <string> {
    let raw <[char]> = random_bytes(16);
    let key <string> = ws_b64encode(raw, 16);
    delete raw;
    return key;
}

priv fun ws_append(owned: string, suffix: string) <string> {
    let result <string> = concat(owned, suffix);
    free_str(owned);
    return result;
}

// The HTTP Upgrade request a client sends. Pure function (no I/O) so tests
// can inspect it.
#[export]
pub fun ws_client_request(host: string, port: int, path: string, key: string) <string> {
    let req <string> = concat("GET ", path);
    req = ws_append(req, " HTTP/1.1\r\nHost: ");
    req = ws_append(req, host);
    // Host header carries the port when it is not the default, so virtual
    // hosts and reverse proxies route correctly.
    if (port != 80) {
        req = ws_append(req, ":");
        // int -> string without printf %d: build via repeated append is
        // overkill here; ports are short, so format manually.
        let pbuf <[char]> = new [char, 8]{};
        let tmp <int> = port;
        let digits <int> = 0;
        if (tmp == 0) { pbuf[0] = '0'; digits = 1; }
        while (tmp > 0) {
            pbuf[digits] = cast<char>(cast<int>('0') + (tmp % 10));
            tmp = tmp / 10;
            digits = digits + 1;
        }
        for (let i <int> = 0; i < digits; i++) {
            let one <[char]> = new [char, 2]{};
            one[0] = pbuf[digits - 1 - i];
            one[1] = cast<char>(0);
            let ds <string> = from_chars(one, 0, 1);
            req = ws_append(req, ds);
            free_str(ds);
            delete one;
        }
        delete pbuf;
    }
    req = ws_append(req, "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ");
    req = ws_append(req, key);
    req = ws_append(req, "\r\nSec-WebSocket-Version: 13\r\n\r\n");
    return req;
}

// HTTP tokens, not substring matches. Empty list elements are invalid.
priv fun ws_token_char(c: char) <bool> {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) { return true; }
    return c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '\'' || c == '*' || c == '+' || c == '-' || c == '.' || c == '^' || c == '_' || c == '`' || c == '|' || c == '~';
}

priv fun ws_token_list(value: string, wanted: string) <bool> {
    let lower <string> = to_lower(value);
    let b <[char]> = to_chars(lower);
    free_str(lower);
    let n <int> = b.length - 1;
    let i <int> = 0;
    let found <bool> = false;
    let valid <bool> = true;
    while (true) {
        while (i < n && (b[i] == ' ' || b[i] == cast<char>(9))) { i++; }
        let start <int> = i;
        while (i < n && ws_token_char(b[i])) { i++; }
        if (i == start) { valid = false; break; }
        let token <string> = from_chars(b, start, i - start);
        if (equals(token, wanted)) { found = true; }
        free_str(token);
        while (i < n && (b[i] == ' ' || b[i] == cast<char>(9))) { i++; }
        if (i == n) { break; }
        if (b[i] != ',') { valid = false; break; }
        i++;
    }
    delete b;
    return valid && found;
}

// Validate complete, bounded HTTP response headers, never a substring in a
// different header or body. No extensions or subprotocols were requested.
#[export]
pub fun ws_validate_server_response(resp: string, key: string) <bool> {
    let n <int> = len(resp);
    let end <int> = find(resp, "\r\n\r\n");
    if (n > 8192 || end < 0 || end + 4 != n) { return false; }
    let eol <int> = find(resp, "\r\n");
    let status <string> = substr(resp, 0, eol);
    let valid <bool> = starts_with(status, "HTTP/1.1 101 ");
    free_str(status);
    if (!valid) { return false; }
    let got_upgrade <bool> = false;
    let got_connection <bool> = false;
    let got_accept <bool> = false;
    let want <string> = ws_accept_key(key);
    let pos <int> = eol + 2;
    while (pos < end) {
        let remaining <string> = substr(resp, pos, n - pos);
        let size <int> = find(remaining, "\r\n");
        let line <string> = substr(remaining, 0, size);
        free_str(remaining);
        let colon <int> = find(line, ":");
        let chars <[char]> = to_chars(line);
        if (colon <= 0) { valid = false; }
        for (let i <int> = 0; i < colon; i++) {
            if (!ws_token_char(chars[i])) { valid = false; }
        }
        for (let i <int> = colon + 1; i < size; i++) {
            let c <uint> = byte_at(chars, i);
            if ((c < cast<uint>(32) && c != cast<uint>(9)) || c == cast<uint>(127)) { valid = false; }
        }
        delete chars;
        if (valid) {
            let raw_name <string> = substr(line, 0, colon);
            let name <string> = to_lower(raw_name);
            free_str(raw_name);
            let raw_value <string> = substr(line, colon + 1, size - colon - 1);
            let value <string> = trim(raw_value);
            free_str(raw_value);
            if (equals(name, "upgrade")) {
                if (got_upgrade || !ws_token_list(value, "websocket")) { valid = false; }
                got_upgrade = true;
            } else if (equals(name, "connection")) {
                if (got_connection || !ws_token_list(value, "upgrade")) { valid = false; }
                got_connection = true;
            } else if (equals(name, "sec-websocket-accept")) {
                if (got_accept || !const_time_eq(value, want)) { valid = false; }
                got_accept = true;
            } else if (equals(name, "sec-websocket-extensions") || equals(name, "sec-websocket-protocol")) {
                valid = false;
            }
            free_str(name);
            free_str(value);
        }
        free_str(line);
        if (!valid) { break; }
        pos = pos + size + 2;
    }
    free_str(want);
    return valid && got_upgrade && got_connection && got_accept;
}

#[export]
pub fun ws_check_handshake_headers(method: string, upgrade: string, connection: string, key: string, version: string) <bool> {
    if (!equals(method, "GET")) { return false; }
    if (!ws_token_list(upgrade, "websocket") || !ws_token_list(connection, "upgrade")) { return false; }
    let v <string> = trim(version);
    let valid <bool> = equals(v, "13");
    free_str(v);
    let k <string> = trim(key);
    if (len(k) != 24) { free_str(k); return false; }
    let decoded <WsBytes> = ws_b64decode(k);
    valid = valid && decoded.len == 16;
    delete decoded.data;
    free_str(k);
    return valid;
}

// --- client connection ---

#[export]
pub struct WsClientResult {
    pub:
        ok <bool>,
        fd <HttpSocket>,
        err <string>,
}

// Build a sockaddr_in the way std networking.fin does (family + port/address
// in network order packed into [int, 4]). `parsed` is c_inet_addr's answer,
// checked by the caller.
priv fun ws_sockaddr(parsed: int, port: int) <[int]> {
    let addr <[int]> = new [int, 4]{};
    addr[0] = cast<int>(2 + cast<long>(port / 256) * 65536 + cast<long>(port % 256) * 16777216);
    addr[1] = parsed;
    addr[2] = 0;
    addr[3] = 0;
    return addr;
}

// Send exactly len bytes, looping over short sends. False on any error.
priv fun ws_send_all(fd: HttpSocket, data: [char], len: int) <bool> {
    let sent <int> = 0;
    while (sent < len) {
        // &data[sent]: address of an element, the same idiom std uses
        // (&buffer[0]).
        // The shared write sends the whole buffer, looping over short writes.
        if (!http_socket_write(fd, data, len)) { return false; }
        sent = len;
    }
    return true;
}

priv fun ws_send_str_all(fd: HttpSocket, s: string) <bool> {
    let bytes <[char]> = to_chars(s);
    let n <int> = bytes.length - 1;
    let ok <bool> = ws_send_all(fd, bytes, n);
    delete bytes;
    return ok;
}

// Receive only HTTP headers. Peek first, then consume through the first
// terminator; bytes of a coalesced WebSocket frame remain in the socket.
priv fun ws_recv_headers(fd: HttpSocket, cap: int) <WsBytes> {
    let buf <[char]> = new [char, cap + 1]{};
    let total <int> = 0;
    while (total < cap) {
        let n <int> = ws_read_at(fd, buf, total, cap - total, 2);
        if (n <= 0) { break; }
        let end <int> = -1;
        let start <int> = total - 3;
        if (start < 0) { start = 0; }
        for (let i <int> = start; i + 3 < total + n; i++) {
            if (buf[i] == cast<char>(13) && buf[i + 1] == cast<char>(10) && buf[i + 2] == cast<char>(13) && buf[i + 3] == cast<char>(10)) {
                end = i + 4;
                break;
            }
        }
        let take <int> = n;
        if (end >= 0) { take = end - total; }
        let consumed <int> = 0;
        while (consumed < take) {
            let got <int> = ws_read_at(fd, buf, total + consumed, take - consumed, 0);
            if (got <= 0) {
                delete buf;
                return WsBytes{data: new [char, 1]{}, len: -1};
            }
            consumed = consumed + got;
        }
        total = total + take;
        if (end >= 0) {
            buf[total] = cast<char>(0);
            return WsBytes{data: buf, len: total};
        }
    }
    delete buf;
    return WsBytes{data: new [char, 1]{}, len: -1};
}

// Open a WebSocket client connection: TCP dial + HTTP Upgrade handshake.
// Returns the connected fd on success; the caller owns it (ws_conn_close).
// Hostnames are NOT resolved — dotted quads only, like std networking.fin.
#[export]
pub fun ws_client_connect(host: string, port: int, path: string) <WsClientResult> {
    let fail <WsClientResult> = WsClientResult{ok: false, fd: -1, err: ""};
    if (port <= 0 || port > 65535) {
        fail.err = "ws_client_connect: port must be in 1..65535";
        return fail;
    }
    // Resolve before opening anything: a bad address is an error, not an
    // abort (blame would leak the socket).
    let parsed <int> = c_inet_addr(host);
    if (parsed == -1) {
        fail.err = "ws_client_connect: cannot parse the address as a dotted quad";
        return fail;
    }
    let fd <HttpSocket> = c_socket(2, 1, 0);
    if (fd < 0) {
        fail.err = "ws_client_connect: cannot open a socket";
        return fail;
    }
    let addr <[int]> = ws_sockaddr(parsed, port);
    let err <int> = c_connect(fd, &addr[0], 16);
    delete addr;
    if (err != 0) {
        c_close(fd);
        fail.err = "ws_client_connect: cannot connect";
        return fail;
    }
    let key <string> = ws_client_key();
    let req <string> = ws_client_request(host, port, path, key);
    let sent <bool> = ws_send_str_all(fd, req);
    free_str(req);
    if (!sent) {
        free_str(key);
        c_close(fd);
        fail.err = "ws_client_connect: cannot send the handshake";
        return fail;
    }
    let resp <WsBytes> = ws_recv_headers(fd, 8192);
    if (resp.len < 0) {
        delete resp.data;
        free_str(key);
        c_close(fd);
        fail.err = "ws_client_connect: no handshake response";
        return fail;
    }
    let resp_s <string> = from_chars(resp.data, 0, resp.len);
    delete resp.data;
    let valid <bool> = ws_validate_server_response(resp_s, key);
    free_str(resp_s);
    free_str(key);
    if (!valid) {
        c_close(fd);
        fail.err = "ws_client_connect: bad 101 response or accept key";
        return fail;
    }
    return WsClientResult{ok: true, fd: fd, err: ""};
}

#[export]
pub fun ws_conn_close(fd: int) <bool> {
    if (fd < 0) { return false; }
    return c_close(fd) == 0;
}

// --- server side (handshake via zhttp) ---

#[export]
pub struct WsAcceptResult {
    pub:
        ok <bool>,
        fd <HttpSocket>,
        err <string>,
}

// Listen for WebSocket connections. Thin wrapper over zhttp so the HTTP
// parsing (request line, headers) is reused, not reimplemented.
#[export]
pub fun ws_server_listen(port: int) <&HttpServer> {
    return http_listen(port);
}

#[export]
pub fun ws_server_close(srv: &HttpServer) <noret> {
    http_server_close(srv);
}

// Accept one connection and run the server side of the opening handshake.
// On success returns the raw TCP fd — the HTTP layer is done, and from here
// the peer speaks WebSocket frames (use ws_send_frame / ws_recv_message).
//
// HttpConn currently owns only an fd and has no destructor: close/free it on
// failure; on success transfer fd ownership and delete only its wrapper.
#[export]
pub fun ws_server_accept(srv: &HttpServer) <WsAcceptResult> {
    let fail <WsAcceptResult> = WsAcceptResult{ok: false, fd: -1, err: ""};
    let conn <&HttpConn> = http_accept(srv);
    let rr <HttpReadResult> = http_read_request(conn);
    if (!rr.ok) {
        http_free_read_result(&rr);
        http_close(conn);
        fail.err = "ws_server_accept: cannot read the HTTP request";
        return fail;
    }
    let method <string> = rr.req.method;
    let upgrade <string> = http_header_get(rr.req.headers, "Upgrade");
    let connection <string> = http_header_get(rr.req.headers, "Connection");
    let key <string> = http_header_get(rr.req.headers, "Sec-WebSocket-Key");
    let version <string> = http_header_get(rr.req.headers, "Sec-WebSocket-Version");
    let host <string> = http_header_get(rr.req.headers, "Host");
    if (!equals(rr.req.version, "HTTP/1.1") || len(host) == 0 || !ws_check_handshake_headers(method, upgrade, connection, key, version)) {
        ws_send_str_all(conn.fd, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
        // http_free_read_result frees the request too — no separate
        // http_free_request (that would double-free).
        http_free_read_result(&rr);
        http_close(conn);
        fail.err = "ws_server_accept: not a valid WebSocket handshake";
        return fail;
    }
    let clean_key <string> = trim(key);
    let accept <string> = ws_accept_key(clean_key);
    free_str(clean_key);
    http_free_read_result(&rr);
    let first <string> = concat("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ", accept);
    let resp <string> = concat(first, "\r\n\r\n");
    free_str(first);
    free_str(accept);
    // Use our MSG_NOSIGNAL send path: peer disconnects are recoverable.
    let sent <bool> = ws_send_str_all(conn.fd, resp);
    free_str(resp);
    if (!sent) {
        http_close(conn);
        fail.err = "ws_server_accept: cannot write the 101 response";
        return fail;
    }
    let fd <HttpSocket> = conn.fd;
    delete conn;
    return WsAcceptResult{ok: true, fd: fd, err: ""};
}

// --- frames (RFC 6455 section 5) ---
//
// Opcodes (int codes — no enum fields, backend limit 1):
//   0 = continuation, 1 = text, 2 = binary,
//   8 = close, 9 = ping, 10 = pong.
// Close codes (section 7.4): 1000 normal, 1001 going away, 1002 protocol
// error, 1003 unsupported data, 1007 invalid payload, 1008 policy violation,
// 1009 message too big, 1011 internal error.

#[export]
pub struct WsDecodeResult {
    pub:
        ok <bool>,
        fin <bool>,
        opcode <int>,
        masked <bool>,
        payload <[char]>,
        payload_len <int>,
        consumed <int>,
        error_code <int>, // 0: incomplete/I/O, 1002: protocol, 1007: UTF-8, 1009: limit
        err <string>,
}

#[export]
pub fun ws_free_decode(r: &WsDecodeResult) <noret> {
    delete r.payload;
}

// Encode one frame. mask_len == 0 -> unmasked (server use); mask_len == 4 ->
// masked with mask_key (client use, RFC 6455 section 5.3: clients MUST mask).
// Deterministic: the caller supplies the key, so tests can use fixed keys.
#[export]
pub fun ws_encode(fin: bool, opcode: int, payload: [char], payload_len: int, mask_key: [char], mask_len: int) <WsBytes> {
    blame payload_len >= 0, "ws_encode: payload length must be non-negative";
    blame mask_len == 0 || mask_len == 4, "ws_encode: mask is 0 or 4 bytes";
    blame opcode >= 0 && opcode <= 15, "ws_encode: opcode is 4 bits";
    let masked <bool> = mask_len == 4;
    let hdr_len <int> = 2;
    if (payload_len >= 126 && payload_len < 65536) { hdr_len = 4; }
    if (payload_len >= 65536) { hdr_len = 10; }
    if (masked) { hdr_len = hdr_len + 4; }
    let total <int> = hdr_len + payload_len;
    let out <[char]> = new [char, total + 1]{};
    let b0 <uint> = cast<uint>(opcode);
    if (fin) { b0 = bit_or(b0, cast<uint>(128)); }
    out[0] = cast<char>(cast<int>(b0));
    let b1 <uint> = cast<uint>(0);
    if (masked) { b1 = cast<uint>(128); }
    let o <int> = 2;
    if (payload_len < 126) {
        b1 = bit_or(b1, cast<uint>(payload_len));
        out[1] = cast<char>(cast<int>(b1));
    } else if (payload_len < 65536) {
        b1 = bit_or(b1, cast<uint>(126));
        out[1] = cast<char>(cast<int>(b1));
        out[2] = cast<char>(payload_len / 256);
        out[3] = cast<char>(payload_len % 256);
        o = 4;
    } else {
        // 64-bit length: high 32 bits are zero (payload_len is a 32-bit int).
        b1 = bit_or(b1, cast<uint>(127));
        out[1] = cast<char>(cast<int>(b1));
        out[2] = cast<char>(0);
        out[3] = cast<char>(0);
        out[4] = cast<char>(0);
        out[5] = cast<char>(0);
        let hi <uint> = cast<uint>(payload_len) >> cast<uint>(24);
        out[6] = cast<char>(cast<int>(hi));
        out[7] = cast<char>(cast<int>((cast<uint>(payload_len) >> cast<uint>(16)) % cast<uint>(256)));
        out[8] = cast<char>(cast<int>((cast<uint>(payload_len) >> cast<uint>(8)) % cast<uint>(256)));
        out[9] = cast<char>(cast<int>(cast<uint>(payload_len) % cast<uint>(256)));
        o = 10;
    }
    if (masked) {
        for (let i <int> = 0; i < 4; i++) { out[o + i] = mask_key[i]; }
        o = o + 4;
    }
    for (let i <int> = 0; i < payload_len; i++) {
        let byte <uint> = byte_at(payload, i);
        if (masked) {
            byte = bit_xor(byte, byte_at(mask_key, i % 4));
        }
        out[o + i] = cast<char>(cast<int>(byte));
    }
    out[total] = cast<char>(0);
    return WsBytes{data: out, len: total};
}

// Header parsing is shared by the pure codec and socket reader. It performs
// all header-only checks before any payload allocation/read. role: -1 either,
// 0 server (unmasked), 1 client (masked).
struct WsHeader {
    ok <bool>, fin <bool>, opcode <int>, masked <bool>,
    size <int>, payload_len <int>, error_code <int>, err <string>,
}

priv fun ws_header(data: [char], count: int, role: int) <WsHeader> {
    let h <WsHeader> = WsHeader{ok: false, fin: false, opcode: 0, masked: false, size: 2, payload_len: 0, error_code: 0, err: "incomplete frame header"};
    if (count < 2) { return h; }
    let b0 <uint> = byte_at(data, 0);
    let b1 <uint> = byte_at(data, 1);
    h.fin = bit_and(b0, cast<uint>(128)) != cast<uint>(0);
    h.opcode = cast<int>(bit_and(b0, cast<uint>(15)));
    h.masked = bit_and(b1, cast<uint>(128)) != cast<uint>(0);
    let mark <int> = cast<int>(bit_and(b1, cast<uint>(127)));
    h.error_code = 1002;
    h.err = "invalid frame header";
    if (bit_and(b0, cast<uint>(112)) != cast<uint>(0)) { return h; }
    if (h.opcode != 0 && h.opcode != 1 && h.opcode != 2 && h.opcode != 8 && h.opcode != 9 && h.opcode != 10) { return h; }
    if ((role == 1 && !h.masked) || (role == 0 && h.masked)) { h.err = "incorrect frame masking direction"; return h; }
    if (h.opcode >= 8 && (!h.fin || mark > 125)) { h.err = "invalid control frame size or FIN"; return h; }
    h.error_code = 0;
    if (mark == 126) { h.size = 4; }
    if (mark == 127) { h.size = 10; }
    if (count < h.size) { return h; }
    let size <ulong> = cast<ulong>(mark);
    if (mark >= 126) {
        size = cast<ulong>(0);
        if (mark == 127 && byte_at(data, 2) >= cast<uint>(128)) { h.error_code = 1002; h.err = "invalid 64-bit length"; return h; }
        for (let i <int> = 2; i < h.size; i++) { size = size * cast<ulong>(256) + cast<ulong>(byte_at(data, i)); }
        if ((mark == 126 && size < cast<ulong>(126)) || (mark == 127 && size < cast<ulong>(65536))) {
            h.error_code = 1002; h.err = "nonminimal frame length"; return h;
        }
    }
    if (size > cast<ulong>(16777216)) { h.error_code = 1009; h.err = "frame exceeds 16 MiB cap"; return h; }
    h.payload_len = cast<int>(size);
    if (h.masked) { h.size = h.size + 4; }
    h.ok = true;
    h.err = "";
    return h;
}

priv fun ws_valid_close_code(code: int) <bool> {
    return (code >= 1000 && code <= 1014 && code != 1004 && code != 1005 && code != 1006) || (code >= 3000 && code <= 4999);
}

// Length-based UTF-8, including embedded NUL. Validate complete text after
// reassembly so a codepoint may span any number of fragments.
priv fun ws_utf8(data: [char], start: int, count: int) <bool> {
    let i <int> = start;
    let end <int> = start + count;
    while (i < end) {
        let first <int> = cast<int>(byte_at(data, i));
        i++;
        if (first <= 127) { continue; }
        let more <int> = 0;
        let value <int> = 0;
        let minimum <int> = 0;
        if (first >= 194 && first <= 223) { more = 1; value = first - 192; minimum = 128; }
        else if (first >= 224 && first <= 239) { more = 2; value = first - 224; minimum = 2048; }
        else if (first >= 240 && first <= 244) { more = 3; value = first - 240; minimum = 65536; }
        else { return false; }
        if (more > end - i) { return false; }
        for (let j <int> = 0; j < more; j++) {
            let next <int> = cast<int>(byte_at(data, i));
            if (next < 128 || next > 191) { return false; }
            value = value * 64 + next - 128;
            i++;
        }
        if (value < minimum || value > 1114111 || (value >= 55296 && value <= 57343)) { return false; }
    }
    return true;
}

priv fun ws_close_error(data: [char], count: int) <int> {
    if (count == 1) { return 1002; }
    if (count >= 2) {
        let code <int> = cast<int>(byte_at(data, 0)) * 256 + cast<int>(byte_at(data, 1));
        if (!ws_valid_close_code(code)) { return 1002; }
        if (!ws_utf8(data, 2, count - 2)) { return 1007; }
    }
    return 0;
}

priv fun ws_decode_error(code: int, message: string) <WsDecodeResult> {
    return WsDecodeResult{ok: false, fin: false, opcode: 0, masked: false, payload: new [char, 1]{}, payload_len: 0, consumed: 0, error_code: code, err: message};
}

// Incomplete input: error_code=0, consumed=0. Invalid peer input is recoverable.
#[export]
pub fun ws_decode(data: [char], len: int) <WsDecodeResult> {
    if (len < 0 || len > data.length) { return ws_decode_error(1002, "invalid input length"); }
    let h <WsHeader> = ws_header(data, len, -1);
    if (!h.ok) { return ws_decode_error(h.error_code, h.err); }
    if (len < h.size + h.payload_len) { return ws_decode_error(0, "incomplete frame payload"); }
    let payload <[char]> = new [char, h.payload_len + 1]{};
    for (let i <int> = 0; i < h.payload_len; i++) {
        let byte <uint> = byte_at(data, h.size + i);
        if (h.masked) { byte = bit_xor(byte, byte_at(data, h.size - 4 + i % 4)); }
        payload[i] = cast<char>(cast<int>(byte));
    }
    payload[h.payload_len] = cast<char>(0);
    let code <int> = 0;
    if (h.opcode == 8) { code = ws_close_error(payload, h.payload_len); }
    if (h.opcode == 1 && h.fin && !ws_utf8(payload, 0, h.payload_len)) { code = 1007; }
    if (code != 0) { delete payload; return ws_decode_error(code, "invalid frame payload"); }
    return WsDecodeResult{ok: true, fin: h.fin, opcode: h.opcode, masked: h.masked, payload: payload, payload_len: h.payload_len, consumed: h.size + h.payload_len, error_code: 0, err: ""};
}

// --- frame I/O over a connected fd ---

// Read exactly len bytes, looping over short recvs. ok=false on close/error.
priv fun ws_recv_exact(fd: HttpSocket, len: int) <WsBytes> {
    let buf <[char]> = new [char, len + 1]{};
    let got <int> = 0;
    while (got < len) {
        let n <int> = ws_read_at(fd, buf, got, len - got, 0);
        if (n <= 0) {
            delete buf;
            return WsBytes{data: new [char, 1]{}, len: -1};
        }
        got = got + n;
    }
    buf[len] = cast<char>(0);
    return WsBytes{data: buf, len: len};
}

// Send one frame. masked=true for client -> server traffic (RFC 6455 5.3);
// the mask key is freshly random per frame.
#[export]
pub fun ws_send_frame(fd: HttpSocket, fin: bool, opcode: int, payload: [char], payload_len: int, masked: bool) <bool> {
    if (payload_len < 0 || payload_len > payload.length || payload_len > 16777216) { return false; }
    if (opcode != 0 && opcode != 1 && opcode != 2 && opcode != 8 && opcode != 9 && opcode != 10) { return false; }
    if (opcode >= 8 && (!fin || payload_len > 125)) { return false; }
    if (opcode == 8 && ws_close_error(payload, payload_len) != 0) { return false; }
    if (opcode == 1 && fin && !ws_utf8(payload, 0, payload_len)) { return false; }
    let key <[char]> = new [char, 5]{};
    let key_len <int> = 0;
    if (masked) {
        let rk <[char]> = random_bytes(4);
        for (let i <int> = 0; i < 4; i++) { key[i] = rk[i]; }
        delete rk;
        key_len = 4;
    }
    let enc <WsBytes> = ws_encode(fin, opcode, payload, payload_len, key, key_len);
    delete key;
    let ok <bool> = ws_send_all(fd, enc.data, enc.len);
    delete enc.data;
    return ok;
}

// Read directly into the returned payload, with no wire-buffer copy. Header
// validation (including role and remaining message budget) precedes body reads.
priv fun ws_recv_checked(fd: HttpSocket, role: int, active: bool, remaining: int) <WsDecodeResult> {
    let head <[char]> = new [char, 14]{};
    let used <int> = 0;
    let target <int> = 2;
    let h <WsHeader> = ws_header(head, 0, role);
    while (true) {
        while (used < target) {
            let got <int> = ws_read_at(fd, head, used, target - used, 0);
            if (got <= 0) { delete head; return ws_decode_error(0, "connection closed while reading header"); }
            used = used + got;
        }
        h = ws_header(head, used, role);
        if (h.error_code != 0) { delete head; return ws_decode_error(h.error_code, h.err); }
        if (role != -1 && h.opcode < 8) {
            if ((active && h.opcode != 0) || (!active && h.opcode == 0)) {
                delete head; return ws_decode_error(1002, "invalid fragmentation sequence");
            }
        }
        if (!h.ok) { target = h.size; continue; }
        if (h.opcode < 8 && h.payload_len > remaining) { delete head; return ws_decode_error(1009, "message exceeds 16 MiB cap"); }
        if (used < h.size) { target = h.size; continue; }
        break;
    }
    let pay <WsBytes> = ws_recv_exact(fd, h.payload_len);
    if (pay.len < 0) { delete head; delete pay.data; return ws_decode_error(0, "connection closed while reading payload"); }
    if (h.masked) {
        for (let i <int> = 0; i < h.payload_len; i++) {
            pay.data[i] = cast<char>(cast<int>(bit_xor(byte_at(pay.data, i), byte_at(head, h.size - 4 + i % 4))));
        }
    }
    delete head;
    let code <int> = 0;
    if (h.opcode == 8) { code = ws_close_error(pay.data, pay.len); }
    if (h.opcode == 1 && h.fin && !ws_utf8(pay.data, 0, pay.len)) { code = 1007; }
    if (code != 0) { delete pay.data; return ws_decode_error(code, "invalid frame payload"); }
    return WsDecodeResult{ok: true, fin: h.fin, opcode: h.opcode, masked: h.masked, payload: pay.data, payload_len: pay.len, consumed: h.size + pay.len, error_code: 0, err: ""};
}

// Low-level role-neutral reader. Use ws_recv_message for masking and message
// sequencing enforcement; ok=false distinguishes protocol errors via error_code.
#[export]
pub fun ws_recv_frame(fd: HttpSocket) <WsDecodeResult> {
    return ws_recv_checked(fd, -1, false, 16777216);
}

// --- convenience senders ---

#[export]
pub fun ws_send_text(fd: HttpSocket, text: string, masked: bool) <bool> {
    let bytes <[char]> = to_chars(text);
    let n <int> = bytes.length - 1;
    let ok <bool> = ws_send_frame(fd, true, 1, bytes, n, masked);
    delete bytes;
    return ok;
}

#[export]
pub fun ws_send_binary(fd: HttpSocket, payload: [char], payload_len: int, masked: bool) <bool> {
    return ws_send_frame(fd, true, 2, payload, payload_len, masked);
}

#[export]
pub fun ws_send_ping(fd: HttpSocket, payload: [char], payload_len: int, masked: bool) <bool> {
    if (payload_len > 125) { return false; }
    return ws_send_frame(fd, true, 9, payload, payload_len, masked);
}

#[export]
pub fun ws_send_pong(fd: HttpSocket, payload: [char], payload_len: int, masked: bool) <bool> {
    if (payload_len > 125) { return false; }
    return ws_send_frame(fd, true, 10, payload, payload_len, masked);
}

// Close frame with a status code and optional UTF-8 reason.
#[export]
pub fun ws_send_close(fd: HttpSocket, code: int, reason: string, masked: bool) <bool> {
    if (!ws_valid_close_code(code)) { return false; }
    let rb <[char]> = to_chars(reason);
    let rn <int> = rb.length - 1;
    if (rn > 123 || !ws_utf8(rb, 0, rn)) { delete rb; return false; }
    let body <[char]> = new [char, rn + 3]{};
    body[0] = cast<char>(code / 256);
    body[1] = cast<char>(code % 256);
    for (let i <int> = 0; i < rn; i++) { body[i + 2] = rb[i]; }
    body[rn + 2] = cast<char>(0);
    let ok <bool> = ws_send_frame(fd, true, 8, body, rn + 2, masked);
    delete rb;
    delete body;
    return ok;
}

// --- message reassembly ---

#[export]
pub struct WsMsgResult {
    pub:
        ok <bool>,
        opcode <int>,
        payload <[char]>,
        payload_len <int>,
        closed <bool>,
        error_code <int>,
        err <string>,
}

#[export]
pub fun ws_free_message(m: &WsMsgResult) <noret> {
    delete m.payload;
}

// Read complete messages. All peer errors are recoverable; on protocol
// failure send a role-correct Close and shut down I/O. Caller still owns fd.
#[export]
priv fun ws_message_error(fd: HttpSocket, masked: bool, code: int, message: string) <WsMsgResult> {
    if (code != 0) { ws_send_close(fd, code, "", masked); }
    http_socket_shutdown(fd);
    return WsMsgResult{ok: false, opcode: 0, payload: new [char, 1]{}, payload_len: 0, closed: true, error_code: code, err: message};
}

pub fun ws_recv_message(fd: HttpSocket, from_client: bool) <WsMsgResult> {
    let msg_opcode <int> = -1;
    let acc <[char]> = new [char, 1]{};
    let acc_len <int> = 0;
    let capacity <int> = 0;
    let role <int> = from_client : 1 ? 0;
    let masked <bool> = !from_client;
    while (true) {
        let fr <WsDecodeResult> = ws_recv_checked(fd, role, msg_opcode != -1, 16777216 - acc_len);
        if (!fr.ok) {
            delete acc;
            delete fr.payload;
            return ws_message_error(fd, masked, fr.error_code, fr.err);
        }
        if (fr.opcode == 9) {
            let sent <bool> = ws_send_pong(fd, fr.payload, fr.payload_len, masked);
            delete fr.payload;
            if (!sent) { delete acc; return ws_message_error(fd, masked, 0, "cannot send pong"); }
            continue;
        }
        if (fr.opcode == 10) { delete fr.payload; continue; }
        if (fr.opcode == 8) {
            // Echo bytes, not a C string: empty Close and embedded NUL in its
            // reason must remain exactly intact.
            let sent <bool> = ws_send_frame(fd, true, 8, fr.payload, fr.payload_len, masked);
            delete fr.payload;
            delete acc;
            http_socket_shutdown(fd);
            return WsMsgResult{ok: sent, opcode: 8, payload: new [char, 1]{}, payload_len: 0, closed: true, error_code: 0, err: sent : "" ? "cannot echo close"};
        }
        if (msg_opcode == -1) { msg_opcode = fr.opcode; }
        let new_len <int> = acc_len + fr.payload_len;
        // Geometric capacity: total prefix copying < 2 * message bytes.
        // Empty fragments allocate/copy nothing in the accumulator.
        if (new_len > capacity) {
            let next <int> = capacity;
            if (next < 256) { next = 256; }
            while (next < new_len) { next = next * 2; }
            if (next > 16777216) { next = 16777216; }
            let grown <[char]> = new [char, next + 1]{};
            for (let i <int> = 0; i < acc_len; i++) { grown[i] = acc[i]; }
            delete acc;
            acc = grown;
            capacity = next;
        }
        for (let i <int> = 0; i < fr.payload_len; i++) { acc[acc_len + i] = fr.payload[i]; }
        delete fr.payload;
        acc_len = new_len;
        acc[acc_len] = cast<char>(0);
        if (fr.fin) {
            if (msg_opcode == 1 && !ws_utf8(acc, 0, acc_len)) {
                delete acc;
                return ws_message_error(fd, masked, 1007, "invalid UTF-8 text message");
            }
            return WsMsgResult{ok: true, opcode: msg_opcode, payload: acc, payload_len: acc_len, closed: false, error_code: 0, err: ""};
        }
    }
    delete acc;
    return ws_message_error(fd, masked, 0, "unreachable receive state");
}


}
